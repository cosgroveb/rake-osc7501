# frozen_string_literal: true
# rbs_inline: enabled

source 'https://rubygems.org'
gemspec
gem 'rake', '12.3.3'
rspec_minor = ENV.fetch('RSPEC_MINOR', '3.6')
gem 'rspec', ENV.fetch('RSPEC_VERSION', "~> #{rspec_minor}.0")
gem 'rspec-core', ENV.fetch('RSPEC_CORE_VERSION', "~> #{rspec_minor}.0")
gem 'diff-lcs', '1.3'
gem 'rspec-osc7501', path: ENV['RSPEC_OSC7501_PATH'] if ENV['RSPEC_OSC7501_PATH']
